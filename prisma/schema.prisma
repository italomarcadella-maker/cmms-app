datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- ENUMS ---

enum UserRole {
  ADMIN
  PLANT_MANAGER
  PROCESS_ENGINEER
  SUPERVISOR
  MAINTAINER
  USER
}

enum AssetStatus {
  OPERATIONAL
  MAINTENANCE
  OFFLINE
  DECOMMISSIONED
  STORAGE
}

enum AssetType {
  MACHINE
  FACILITY
  SAFETY
  KAIZEN
  OTHER
}

enum WorkOrderPriority {
  STOPPED
  MALFUNCTIONING
  WORKING
  NOT_PRODUCTION
  HIGH
  MEDIUM
  LOW
}

enum WorkOrderCategory {
  MECHANICAL
  ELECTRICAL
  HYDRAULIC
  PNEUMATIC
  SOFTWARE
  CIVIL
  OTHER
  SAFETY
  IMPROVEMENT
  AI_SUGGESTION
}

enum WorkOrderStatus {
  OPEN
  PENDING_APPROVAL
  APPROVED
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  PENDING_REVIEW
  COMPLETED
  CLOSED
  CANCELED
}

enum WorkOrderType {
  FAULT
  ROUTINE
  REQUEST
}

// --- MODELS ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER") // Keep as String for NextAuth simplicity or migrate to Enum? Let's keep String for now to avoid Auth issues, focusing on Domain Data.
  mustChangePassword Boolean @default(false)
  isActive      Boolean   @default(true)
  lastLogin     DateTime?
  department    String?
  // plantId = stabilimento "di casa" (selezionato all'accesso). Gli stabilimenti visibili sono in `plants`
  // (un responsabile di plant puo' averne piu' di uno); ADMIN vede sempre tutti.
  plantId       String?
  plant         Plant?    @relation(fields: [plantId], references: [id])
  plants        UserPlant[]
  accounts      Account[]
  sessions      Session[]
  notifications Notification[]
  auditLogs     AuditLog[]
  
  // Workflow Relations
  requestedWorkOrders WorkOrder[] @relation("RequestedBy")
  validatedWorkOrders WorkOrder[] @relation("ValidatedBy")
  availability        TechnicianAvailability[]
  technicianProfile   Technician?
  
  // AI & FPES
  simulationSnapshots LineSimulationVersion[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Asset {
  id              String   @id @default(cuid())
  name            String
  model           String
  serialNumber    String   @unique
  vendor          String?
  plantId         String?
  plant           Plant?    @relation(fields: [plantId], references: [id])
  department      String?
  location        String
  line            String?
  cespite         String?
  purchaseDate    DateTime
  status          AssetStatus   @default(OPERATIONAL)
  healthScore     Int      @default(100)
  lastMaintenance DateTime?
  type            AssetType   @default(MACHINE)
  
  warrantyExpiration DateTime?
  
  images          AssetImage[]
  documents       AssetDocument[]
  workOrders      WorkOrder[]
  schedules       PreventiveSchedule[]
  contractorActivities ContractorActivity[]
  
  // Process Engineering
  sopDocuments    SopDocument[]
  processAnomalies ProcessAnomaly[]

  // Nuovi moduli SOP e FPES
  processRecipes   ProcessRecipe[]
  knowledgeDefects KnowledgeDefect[]
  lineSimulations  LineSimulation[]

  @@index([healthScore])
  @@index([status])
  @@index([name])
  @@index([plantId])
  @@index([vendor, model])
}

model AssetDocument {
  id      String @id @default(cuid())
  name    String
  url     String
  type    String
  date    DateTime?
  asset   Asset  @relation(fields: [assetId], references: [id])
  assetId String
}

model AssetImage {
  id      String @id @default(cuid())
  url     String
  asset   Asset  @relation(fields: [assetId], references: [id])
  assetId String
}

model WorkOrder {
  id                   String   @id @default(cuid())
  title                String
  description          String
  priority             WorkOrderPriority
  category             WorkOrderCategory
  status               WorkOrderStatus   @default(OPEN)
  assignedTo           String?
  assignedTechnicianId String?
  assignedTechnician   Technician? @relation(fields: [assignedTechnicianId], references: [id])
  technicians          WorkOrderTechnician[]

  // Workflow Fields
  requesterId          String?
  requester            User?    @relation("RequestedBy", fields: [requesterId], references: [id])
  
  validatedById        String?
  validator            User?    @relation("ValidatedBy", fields: [validatedById], references: [id])

  type                 WorkOrderType   @default(FAULT)
  requestImage         String?
  completionImage      String?
  
  dueDate              DateTime?
  createdAt            DateTime @default(now())
  
  asset                Asset    @relation(fields: [assetId], references: [id])
  assetId              String
  plantId              String?
  plant                Plant?   @relation(fields: [plantId], references: [id])

  
  checklist            ChecklistItem[]
  partsUsed            WorkOrderPart[]
  laborLogs            LaborLog[]
  timers               WorkOrderTimer[]

  originSchedule       PreventiveSchedule? @relation(fields: [originScheduleId], references: [id])
  originScheduleId     String?
  
  // EWO Fields
  ewoFilled            Boolean @default(false)
  ewo                  EWO?
  
  // Daily Meetings link
  originMeetingId      String?
  originMeeting        DailyMeeting? @relation(fields: [originMeetingId], references: [id])
  
  @@index([dueDate])
  @@index([status])
  @@index([assetId])
  @@index([assignedTechnicianId])
  @@index([createdAt]) // New Index for Trends
  @@index([priority]) // New Index for High Priority checks
  @@index([plantId])
}




model EWO {
  id                String    @id @default(cuid())
  workOrderId       String    @unique
  workOrder         WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  
  description       String?   // Description of the emergency
  causeAnalysis     String    // Root cause (5 Whys)
  solutionApplied   String    // Immediate fix
  
  preventiveActions String?   // What to do to prevent recurrence
  
  needsFollowUp     Boolean   @default(false)
  followUpDetail    String?   // Details for the new request
  
  createdAt         DateTime  @default(now())
  authorName        String

  // Enhanced EWO Fields
  downtimeStart     DateTime?
  downtimeEnd       DateTime?
  totalDowntimeMin  Int?      // Check if this can be computed
  
  productionImpact  String?   // 'NONE', 'SLOWDOWN', 'STOPPAGE'
  
  imageBefore       String?   // Base64 or URL
  imageAfter        String?   // Base64 or URL
}

model SystemSettings {
  id                     String @id @default("settings")
  ewoThresholdHours      Float  @default(0) // 0 means disabled
  downtimeCostPerMinute  Float  @default(100) // EUR/min, used to estimate downtime cost in KPIs
  defaultLaborHourlyRate Float  @default(30)  // EUR/h, fallback when a technician has no hourlyRate set
  electricityPricePerKwh Float  @default(0.22) // EUR/kWh, used in sustainability cost estimates
  waterPricePerM3        Float  @default(0.85) // EUR/m3, used in sustainability cost estimates
  co2FactorPerKwh        Float  @default(0.44) // kg CO2/kWh, grid emission factor
  erpEndpointUrl         String? // ERP integration endpoint; unset = not connected, no real call is made yet
  iotGatewayUrl          String? // IoT gateway endpoint; unset = not connected, no real call is made yet
}

model ChecklistItem {
  id          String    @id @default(cuid())
  label       String
  completed   Boolean   @default(false)
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workOrderId String
  
  // Optional: Who checked it and when
  checkedBy   String?
  checkedAt   DateTime?
}

model WorkOrderPart {
  id          String    @id @default(cuid())
  partId      String
  partName    String
  quantity    Int
  unitCost    Float
  dateAdded   DateTime
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workOrderId String
}

model LaborLog {
  id             String    @id @default(cuid())
  technicianId   String
  technicianName String
  hours          Float
  date           DateTime
  note           String?
  workOrder      WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workOrderId    String
}

model Technician {
  id         String @id @default(cuid())
  name       String
  specialty  String
  hourlyRate Float
  skills     String[] @default([]) // For intelligent AI routing based on project/anomaly requirements
  
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String @unique

  assignments          WorkOrderTechnician[]
  workOrders           WorkOrder[] // Legacy Relation kept for compatibility
  loans                TechnicianLoan[]
}

model WorkOrderTechnician {
  id           String    @id @default(cuid())
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workOrderId  String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  technicianId String
  assignedAt   DateTime  @default(now())
  
  @@unique([workOrderId, technicianId])
}

model MaintenanceActivity {
  id       String  @id @default(cuid())
  label    String
  category String?
}

model PreventiveSchedule {
  id            String   @id @default(cuid())
  taskTitle     String
  description   String
  frequency     String   @default("MONTHLY") // WEEKLY, MONTHLY, BIMONTHLY, QUARTERLY, SEMIANNUAL, ANNUAL
  frequencyDays Int      @default(30) // Legacy / Calculated fallback
  activities    String   @default("[]") // JSON string of checklist items
  lastRunDate   DateTime?
  nextDueDate   DateTime
  assignedToId  String?
  sourceTemplateId String? // Se adottato dalla libreria condivisa per modello di macchina

  asset         Asset    @relation(fields: [assetId], references: [id])
  assetId       String

  generatedWorkOrders WorkOrder[]

  @@index([nextDueDate])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String   // e.g. "Nuova Assegnazione"
  message   String   // e.g. "Ti è stato assegnato l'ordine #123"
  read      Boolean  @default(false)
  link      String?  // e.g. "/work-orders/123"
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Meter {
  id               String   @id @default(cuid())
  name             String
  type             String   // ELEC, WATER, GAS
  unit             String   // kWh, m3
  serialNumber     String?
  location         String?
  installationDate DateTime?
  plantId          String?
  plant            Plant?   @relation(fields: [plantId], references: [id])

  // Lettura pianificata: ogni quanti giorni, prossima scadenza e chi la esegue (id utente). Null = non pianificata.
  readingFrequencyDays Int?
  nextReadingDue       DateTime?
  readingAssigneeId    String?

  readings         MeterReading[]

  @@index([plantId])
  @@index([nextReadingDue])
}

model MeterReading {
  id         String   @id @default(cuid())
  meterId    String
  date       DateTime
  value      Float
  
  // AI / Analysis Fields
  isAnomaly  Boolean  @default(false)
  aiAnalysis String?  // Explanation of the anomaly
  
  createdAt  DateTime @default(now())
  
  meter      Meter    @relation(fields: [meterId], references: [id], onDelete: Cascade)

  @@index([meterId, date])
}

model SparePart {
  id          String   @id @default(cuid())
  name        String
  category    String?
  description String?
  warehouse   String? // Added to support UI
  vendor      String? // Phase 9: Supplier
  quantity    Int
  minQuantity Int      @default(0)
  location    String?
  plantId     String?
  plant       Plant?   @relation(fields: [plantId], references: [id])
  unitCost    Float    @default(0)
  lastUpdated DateTime @default(now())

  // Una riga SparePart = la giacenza di UN articolo in UN plant. Il catalogo unico (per descrizione)
  // permette di riconoscere lo stesso articolo in plant diversi, perche' non esiste un codice comune.
  catalogId   String?
  catalog     SparePartCatalog? @relation(fields: [catalogId], references: [id])

  purchaseRequests PurchaseRequest[]
  transfersOut     PartTransferRequest[]

  @@index([plantId])
  @@index([catalogId])
}

/// Catalogo ricambi di gruppo: un articolo logico, riconosciuto dalla descrizione normalizzata.
model SparePartCatalog {
  id          String   @id @default(cuid())
  name        String            // descrizione canonica
  normalizedKey String @unique  // descrizione normalizzata (minuscole, senza accenti/punteggiatura, token ordinati)
  category    String?
  vendor      String?
  description String?
  createdAt   DateTime @default(now())

  stocks      SparePart[]
  transfers   PartTransferRequest[]

  @@index([name])
}

/// Richiesta di trasferimento di un ricambio da un plant all'altro (approvata dal plant che lo cede).
model PartTransferRequest {
  id            String   @id @default(cuid())
  catalogId     String?
  catalog       SparePartCatalog? @relation(fields: [catalogId], references: [id])
  partName      String
  fromPlantId   String
  toPlantId     String
  fromPart      SparePart @relation(fields: [fromPartId], references: [id], onDelete: Cascade)
  fromPartId    String
  quantity      Int
  status        String   @default("REQUESTED") // REQUESTED, APPROVED, REJECTED, RECEIVED, CANCELED
  note          String?
  decisionNote  String?
  requestedById String
  decidedById   String?
  createdAt     DateTime @default(now())
  decidedAt     DateTime?
  receivedAt    DateTime?

  fromPlant     Plant    @relation("TransfersOut", fields: [fromPlantId], references: [id], onDelete: Cascade)
  toPlant       Plant    @relation("TransfersIn", fields: [toPlantId], references: [id], onDelete: Cascade)

  @@index([fromPlantId, status])
  @@index([toPlantId, status])
}

/// Tecnico prestato temporaneamente da un plant a un altro.
model TechnicianLoan {
  id            String   @id @default(cuid())
  technicianId  String
  technician    Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  fromPlantId   String
  toPlantId     String
  startDate     DateTime
  endDate       DateTime
  status        String   @default("REQUESTED") // REQUESTED, APPROVED, REJECTED, CANCELED
  note          String?
  requestedById String
  decidedById   String?
  createdAt     DateTime @default(now())
  decidedAt     DateTime?

  fromPlant     Plant    @relation("LoansOut", fields: [fromPlantId], references: [id], onDelete: Cascade)
  toPlant       Plant    @relation("LoansIn", fields: [toPlantId], references: [id], onDelete: Cascade)

  @@index([toPlantId, status])
  @@index([fromPlantId, status])
}

/// Libreria di gruppo: piani preventivi e SOP pubblicati per modello di macchina, adottabili (e adattabili) da ogni plant.
model SharedTemplate {
  id            String   @id @default(cuid())
  kind          String   // PM, SOP
  title         String
  description   String?
  assetVendor   String?
  assetModel    String
  payload       Json
  originPlantId String
  originPlant   Plant    @relation(fields: [originPlantId], references: [id], onDelete: Cascade)
  createdById   String
  createdByName String?
  adoptions     Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([assetModel])
  @@index([kind])
}

model Component {
  id              String   @id @default(cuid())
  code            String
  type            String   // SCREW, BARREL
  model           String
  nominalDiameter Float?
  manufacturer    String
  usageType       String   // SOTTOSTRATO, COPERTURA, JOLLY
  warehouse       String   // RETINATO, MAGLIATO
  location        String
  plantId         String?
  plant           Plant?   @relation(fields: [plantId], references: [id])
  status          String   // OPTIMAL, WARNING, CRITICAL, etc.
  purchaseDate    DateTime
  
  referenceDrawing String?
  drawingUrl       String?
  isScrapped       Boolean @default(false)
  hoursUsed        Float   @default(0)
  
  // Storing simple lifecycle dates as JSON for flexibility or could be separate fields
  lifecycle       Json?    
  
  measurements     ComponentMeasurement[]
  assignedAssetId  String?
}

model ComponentMeasurement {
  id          String   @id @default(cuid())
  componentId String
  date        DateTime
  value1      Float
  value2      Float?
  operator    String
  
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
}

model WorkOrderTimer {
  id          String    @id @default(cuid())
  workOrderId String
  userId      String    // Who started the session
  startTime   DateTime  @default(now())
  endTime     DateTime? // Null if currently running
  duration    Int?      // Minutes, calculated on close
  note        String?   // Reason for pause/stop

  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String   @id @default(cuid())
  sender    String
  role      String   // USER, TECHNICIAN, SUPERVISOR, SYSTEM
  content   String
  timestamp DateTime @default(now())
  isRead    Boolean  @default(false)
  isSystem  Boolean  @default(false)
  thoughtProcess String[] @default([])
  imageUrl  String?
}

model MaintenanceKnowledge {
  id           String   @id @default(cuid())
  problemTags  String   // Keywords: "filtro, intasato, rumore"
  solution     String   // "Sostituzione cartuccia"
  assetCategory String? // "Idraulica", "Elettrica"
  successCount Int      @default(1)
  lastUpdated  DateTime @default(now())

  @@index([problemTags])
}

model TechnicianAvailability {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  status    String   // AVAILABLE, VACATION, SICK, TRAINING, PERMIT
  shift     String?  // MORNING, AFTERNOON, NIGHT, DAY
  notes     String?
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date]) // Ensure one status per user per day
}

model ProductionLine {
  id             String @id @default(cuid())
  plantId        String?
  plant          Plant? @relation(fields: [plantId], references: [id])
  line           String // nome linea, unico all'interno del plant
  prodStartDay   Int    @default(1) // 1=Mon
  prodStartTime  String @default("06:00")
  prodEndDay     Int    @default(5) // 5=Fri
  prodEndTime    String @default("22:00")
  maintStart     String @default("08:00")
  maintEnd       String @default("17:00")
  maintStartDay  Int    @default(1) // 1=Mon
  maintEndDay    Int    @default(5) // 5=Fri
  
  maintSatStart  String? // Optional Saturday Shift
  maintSatEnd    String?
  maintSunStart  String? // Optional Sunday Shift
  maintSunEnd    String?

  updatedAt      DateTime @default(now())

  @@unique([plantId, line])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  action      String   // e.g., "CREATE_WO", "UPDATE_STOCK", "LOGIN"
  resourceId  String?  // ID of the object affected
  details     String?  // JSON string or text summary
  timestamp   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


// --- PROCESS ENGINEERING MODELS ---

model Project {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("PLANNING") // PLANNING, ACTIVE, ON_HOLD, COMPLETED
  startDate   DateTime
  endDate     DateTime
  progress    Int      @default(0)
  roi         Float?   // Return on investment estimation (economic)
  ecologicalRoi Float? // Estimated ecological savings (e.g. CO2 reduction)
  expectedEnergySavings Float? // Estimated energy savings in kWh or percentage
  plantId     String?
  plant       Plant?   @relation(fields: [plantId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks       ProjectTask[]

  @@index([plantId])
}

model ProjectTask {
  id                String   @id @default(cuid())
  projectId         String
  title             String
  status            String   @default("TODO") // TODO, IN_PROGRESS, REVIEW, DONE
  startDate         DateTime
  endDate           DateTime
  linkedWorkOrderId String?  // Optional bridge to Maintenance
  dependencies      String?  // JSON list of parent Task IDs
  orderIndex        Int      @default(0) // Visual sorting
  
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  notes             ProjectTaskNote[]
}

model ProjectTaskNote {
  id          String      @id @default(cuid())
  taskId      String
  content     String
  authorName  String
  createdAt   DateTime    @default(now())
  task        ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model SopDocument {
  id                    String   @id @default(cuid())
  title                 String
  assetId               String
  imageUrl              String?  // Reference HMI photo
  videoUrl              String?  // Video reference for Video-to-SOP
  mediaFrames           Json?    // Optional JSON array of extracted keyframes from video/images
  aiExtractedParameters String   // JSON of { label, optimalValue, tolerance }
  author                String
  line                  String?  // Associated production line
  product               String?  // Associated product
  sourceTemplateId      String?  // Se adottata dalla libreria condivisa per modello di macchina
  version               Int      @default(1)
  previousVersionId     String?  // For Git-style versioning / Rollbacks
  isApproved            Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  asset                 Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  feedbacks             SopFeedback[]

  @@index([assetId])
}

model SopFeedback {
  id          String   @id @default(cuid())
  sopId       String
  userId      String   // Using String to prevent circular loop if User is deleted, or add relation
  title       String   // e.g. "Suggerimento per step 3"
  description String   // "Risparmio 5 secondi se usiamo la pinza blu"
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt   DateTime @default(now())

  sop         SopDocument @relation(fields: [sopId], references: [id], onDelete: Cascade)
  // Optional: user User @relation(fields: [userId], references: [id])  -- leaving just String for simplicity unless needed

}

model ProcessAnomaly {
  id               String   @id @default(cuid())
  assetId          String
  detectedAt       DateTime @default(now())
  description      String   // e.g. "Temperature +15°C above SOP"
  aiRecommendation String?  // AI suggests lower extruder speed
  isPredictive     Boolean  @default(false) // If true, it's a forecast, not a current error yet
  autoRcaData      Json?    // Pre-filled 5 whys suggestions from historical AI analysis
  isResolved       Boolean  @default(false)
  
  asset            Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, detectedAt])
}

// --- DAILY MEETING MODELS ---

model DailyMeeting {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  department  String   // RETINATO, MAGLIATO
  status      String   @default("DRAFT") // DRAFT, COMPLETED
  conductedBy String?  // User ID or name
  plantId     String?
  plant       Plant?   @relation(fields: [plantId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections    MeetingSection[]
  generatedOrders WorkOrder[]

  @@index([plantId])
}

model MeetingSection {
  id          String   @id @default(cuid())
  meetingId   String
  type        String   // SAFETY, QUALITY, PRODUCTION, MAINTENANCE
  content     String?  // Rich text notes or generalized text
  kpiMetrics  Json?    // Specific data structured for the section type (e.g. { line1_OEE: 85, nc_count: 2 })
  aiInsights  Json?    // Insights generated by AI specifically for this exact meeting date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  meeting     DailyMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  actionItems MeetingActionItem[]
  
  @@unique([meetingId, type]) // Ensure only 1 section of each type per meeting
}

model MeetingActionItem {
  id                String   @id @default(cuid())
  sectionId         String
  description       String
  assigneeName      String?
  status            String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  linkedWorkOrderId String?  // ID trace back if this spawned an EWO or Routine task
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  section           MeetingSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

// --- INDUSTRY 4.0 & ENTERPRISE MODELS ---

model Plant {
  id          String   @id @default(cuid())
  name        String   @unique
  location    String?
  country     String?
  timezone    String   @default("Europe/Rome")
  createdAt   DateTime @default(now())

  // Impostazioni proprie del plant: se null vale il valore globale di SystemSettings.
  electricityPricePerKwh Float?
  waterPricePerM3        Float?
  co2FactorPerKwh        Float?
  downtimeCostPerMinute  Float?
  defaultLaborHourlyRate Float?

  users       User[]
  members     UserPlant[]
  assets      Asset[]
  workOrders  WorkOrder[]
  spareParts  SparePart[]
  energyLogs  EnergyLog[]
  meters      Meter[]
  components  Component[]
  projects    Project[]
  meetings    DailyMeeting[]
  lines       ProductionLine[]
  transfersOut PartTransferRequest[] @relation("TransfersOut")
  transfersIn  PartTransferRequest[] @relation("TransfersIn")
  loansOut     TechnicianLoan[] @relation("LoansOut")
  loansIn      TechnicianLoan[] @relation("LoansIn")
  sharedTemplates SharedTemplate[]
  safetyEvents SafetyEvent[]
  contractorContracts ContractorContract[]
}

/// Registro degli eventi di sicurezza di uno stabilimento. Serve al contatore "giorni senza infortuni".
/// Non contiene dati personali: niente nomi ne' informazioni sanitarie delle persone coinvolte.
model SafetyEvent {
  id          String   @id @default(cuid())
  plantId     String
  plant       Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  type        String   // INJURY, NEAR_MISS, HAZARD
  occurredAt  DateTime
  description String?
  createdById String
  createdAt   DateTime @default(now())

  @@index([plantId, occurredAt])
}

/// Ditta esterna. L'anagrafica e' di gruppo (la stessa ditta non si duplica); i contratti sono per stabilimento.
/// Solo contatti di lavoro: niente dati personali non necessari.
model Contractor {
  id           String   @id @default(cuid())
  name         String   @unique
  vatNumber    String?
  contactName  String?
  contactPhone String?
  contactEmail String?
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  contracts    ContractorContract[]
}

model ContractorContract {
  id                String   @id @default(cuid())
  contractorId      String
  contractor        Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  plantId           String
  plant             Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  title             String
  scope             String?  // perimetro: cosa copre il contratto
  startDate         DateTime
  endDate           DateTime?
  renewalNoticeDays Int      @default(60)
  annualValue       Float?
  status            String   @default("ACTIVE") // ACTIVE, TERMINATED (la scadenza si ricava dalle date)
  notes             String?
  createdAt         DateTime @default(now())

  activities        ContractorActivity[]

  @@index([plantId, endDate])
  @@index([contractorId])
}

/// Attivita' periodica prevista dal contratto (es. "verifica trimestrale compressore").
model ContractorActivity {
  id            String   @id @default(cuid())
  contractId    String
  contract      ContractorContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  frequencyDays Int
  assetId       String?
  asset         Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  nextDueDate   DateTime
  lastDoneAt    DateTime?
  assigneeId    String?  // referente interno che segue l'attivita'
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  executions    ContractorExecution[]

  @@index([nextDueDate])
  @@index([contractId])
}

model ContractorExecution {
  id          String   @id @default(cuid())
  activityId  String
  activity    ContractorActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  doneAt      DateTime
  outcome     String   // OK, ISSUES
  notes       String?
  reportUrl   String?  // collegamento al rapporto d'intervento
  cost        Float?
  createdById String
  createdAt   DateTime @default(now())

  @@index([activityId, doneAt])
}

/// Stabilimenti visibili a un utente non admin (responsabile di plant: uno o piu').
model UserPlant {
  userId    String
  plantId   String
  createdAt DateTime @default(now())

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plant     Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@id([userId, plantId])
  @@index([plantId])
}

model PurchaseRequest {
  id          String   @id @default(cuid())
  partId      String
  quantity    Int
  status      String   @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, ORDERED, RECEIVED
  reason      String?
  expectedCost Float?
  requestedAt DateTime @default(now())
  orderedAt   DateTime?
  receivedAt  DateTime?
  
  part        SparePart @relation(fields: [partId], references: [id], onDelete: Cascade)
  
  @@index([status])
}

model EnergyLog {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  plantId     String
  assetId     String?  // Optional: can be plant-wide or asset-specific
  kwhConsumed Float
  co2Emitted  Float    // Est. kg of CO2 based on local emission factor
  costLocal   Float?   // Estimated cost in EUR/local currency
  
  plant       Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  // Non colleghiamo esplicitamente ad Asset con constraint per flessibilità, basta l'ID per query.
  
  @@index([plantId, date])
}

// --- GLOBAL AI ENGINE ---
model GlobalInsight {
  id          String   @id @default(cuid())
  title       String
  description String
  source      String   // SOP, FPES, MAINTENANCE, QUALITY
  priority    String   // HIGH, MEDIUM, LOW
  tags        String[]
  assetId     String?
  relatedData Json?    // Per contenere i dettagli incrociati
  isResolved  Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// --- SOP MES MODELS ---
model ProcessRecipe {
  id          String   @id @default(cuid())
  name        String
  assetId     String?  // Relazione alla macchina/linea
  asset       Asset?   @relation(fields: [assetId], references: [id])
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  machines    ProcessMachine[]
  changelogs  ProcessChangelog[]
  readings    QualityReading[]
}

model ProcessMachine {
  id          String   @id @default(cuid())
  recipeId    String
  recipe      ProcessRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name        String
  image       String?
  
  parameters  ProcessParameter[]
}

model ProcessParameter {
  id          String   @id @default(cuid())
  machineId   String
  machine     ProcessMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  name        String
  unit        String
  setPoint    Float
  tolerance   Float
}

model ProcessChangelog {
  id          String   @id @default(cuid())
  recipeId    String
  recipe      ProcessRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  operator    String
  note        String
  timestamp   DateTime @default(now())
}

model QualityReading {
  id          String   @id @default(cuid())
  recipeId    String
  recipe      ProcessRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  value       Float
  timestamp   DateTime @default(now())
}

model KnowledgeDefect {
  id          String   @id @default(cuid())
  assetId     String?
  asset       Asset?   @relation(fields: [assetId], references: [id])
  name        String
  cause       String
  action      String
  priority    String
  createdAt   DateTime @default(now())
}

// --- FPES MODELS ---
model LineSimulation {
  id          String   @id @default(cuid())
  name        String
  assetId     String?
  asset       Asset?   @relation(fields: [assetId], references: [id])
  layout      String
  leanScore   Int      @default(0)
  lineEff     Int      @default(0)
  dataJson    Json     // Contiene turni, macchine, ecc
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  snapshots   LineSimulationVersion[]
}

model LineSimulationVersion {
  id             String   @id @default(cuid())
  simulationId   String
  simulation     LineSimulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  version        Int
  label          String
  leanScore      Int
  lineEff        Int
  snapshotBy     String?
  user           User?    @relation(fields: [snapshotBy], references: [id])
  dataJson       Json
  createdAt      DateTime @default(now())
}
